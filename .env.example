# Copy to .env (git-ignored) and fill in. Spark (free) plan: leave FIREBASE_STORAGE_BUCKET unset.
FIREBASE_PROJECT_ID=my-protfolio-3468a
# Path to the service-account key you download from Firebase (keep it out of git):
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
SESSION_SECRET=paste-a-long-random-string
SITE_URL=http://localhost:3000
